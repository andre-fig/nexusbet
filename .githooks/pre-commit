#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"

echo "[pre-commit] odds-service format + typecheck"
(cd "$root/apps/odds-service" && npm run format:check && npm run typecheck)

echo "[pre-commit] odds-monitor lint/typecheck"
(cd "$root/apps/odds-monitor" && npm run lint)

if [ -d "$root/apps/odds-collector-extension" ]; then
  echo "[pre-commit] odds-collector-extension format + typecheck"
  (cd "$root/apps/odds-collector-extension" && npm run format:check && npm run typecheck)
fi
