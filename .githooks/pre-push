#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"

echo "[pre-push] odds-service build + tests"
(cd "$root/apps/odds-service" && npm run build && npm test)

if [ -n "${TEST_DATABASE_URL:-}" ]; then
  echo "[pre-push] odds-service PostgreSQL integration tests"
  (cd "$root/apps/odds-service" && npm run test:db)
else
  echo "[pre-push] TEST_DATABASE_URL is not set; PostgreSQL integration tests skipped"
fi

echo "[pre-push] odds-monitor build + tests"
(cd "$root/apps/odds-monitor" && npm run build && npm test && npm run test:container)
