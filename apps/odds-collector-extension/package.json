{
  "name": "odds-collector-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/*.mjs\" build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare": "node ../../scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
