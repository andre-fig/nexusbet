# Somente placeholders locais; não inserir credenciais reais.
# Execute a partir de apps/odds-service. Não sobrescreva um .env existente.

# Application
# Porta; bind fixo 127.0.0.1; mínimo configurável 0
PORT=3650
# Lista separada por vírgulas sem espaços
ESPORTS=cs2,lol,valorant
# TTL em segundos, mínimo 1
MAX_AGE_SECONDS=600
# Diretório dos estados/journals
DATA_DIR=data

# Database
# Compose: nome do banco
POSTGRES_DB=odds_service
# Compose: usuário local de exemplo
POSTGRES_USER=odds
# Placeholder local; Compose exige senha; nunca usar senha real versionada
POSTGRES_PASSWORD=local_development_only
# Compose: porta local; atualize DATABASE_URL se mudar
POSTGRES_PORT=5433
# URL local de exemplo; obrigatória em modo postgres
DATABASE_URL=postgresql://odds:local_development_only@127.0.0.1:5433/odds_service
# Exemplo postgres; default do código: postgres se URL definida, senão file
PERSISTENCE_MODE=postgres

# Collection
# Exemplo seguro false; default do código true; aceita true/false/1/0
COLLECTION_ENABLED=false
# Espera inicial, mínimo 0
COLLECTION_STARTUP_DELAY_MS=3000
# Tick em memória, mínimo 100; não é polling remoto
COLLECTION_TICK_MS=1000
# Listagem por provider; mínimo 30000
COLLECTION_LIST_INTERVAL_MS=60000
# Detalhe >24h; mínimo 30000
DETAIL_INTERVAL_GT_24H_MS=600000
# Detalhe 6h–24h inclusivo; mínimo 30000
DETAIL_INTERVAL_6H_24H_MS=300000
# Detalhe >=1h e <6h; mínimo 30000
DETAIL_INTERVAL_1H_6H_MS=120000
# Detalhe >0 e <1h; mínimo 30000
DETAIL_INTERVAL_LT_1H_MS=60000
# Mínimo 0; variação efetiva limitada a menos de 10000ms
COLLECTION_JITTER_MS=5000
# Timeout listagem; mínimo 1
PROVIDER_LIST_TIMEOUT_MS=60000
# Timeout detalhe; mínimo 1
PROVIDER_DETAIL_TIMEOUT_MS=60000
# Falhas consecutivas para cooldown; mínimo 1
PROVIDER_FAILURE_THRESHOLD=5
# Pausa; mínimo 30000
PROVIDER_COOLDOWN_MS=300000
# Primeira falha; mínimo 30000
COLLECTION_BACKOFF_FIRST_MS=30000
# Segunda falha; mínimo 30000
COLLECTION_BACKOFF_SECOND_MS=60000
# Terceira falha; mínimo 30000
COLLECTION_BACKOFF_THIRD_MS=120000
# Quarta falha e seguintes; mínimo 30000
COLLECTION_BACKOFF_MAX_MS=300000
# Espera antes de abort; commits ainda são drenados; mínimo 0
SHUTDOWN_GRACE_MS=30000
# Scanner local; mínimo 1
INBOX_SCAN_INTERVAL_MS=5000
# Somente 0 desabilita timer; false NÃO desabilita
INBOX_SCAN_ENABLED=1
# Somente 0 desabilita ingestão; false NÃO desabilita
INBOX_INGEST_ENABLED=1
# Loop CLI legado, mínimo 60; não altera scheduler
CAPTURE_INTERVAL_SECONDS=180

# Bet365
# Mínimo 1; efetivamente limitado a 1
BET365_MAX_CONCURRENCY=1
# Listagens Bet365
INBOX_DIR=inbox
# Detalhes Bet365
DETAIL_INBOX_DIR=detail-inbox
# Capturas de diagnóstico Bet365; Superbet publica em SUPERBET_INBOX_DIR
CAPTURE_DIR=captures

# Betano
# Mínimo 1; efetivamente limitado a 1
BETANO_MAX_CONCURRENCY=1
# Rodadas Betano
BETANO_INBOX_DIR=betano-inbox
# Capturas Betano
BETANO_CAPTURE_DIR=captures/betano

# Superbet
# Mínimo 1; efetivamente limitado a 1
SUPERBET_MAX_CONCURRENCY=1
# Rodadas Superbet
SUPERBET_INBOX_DIR=superbet-inbox

# Browser/CDP
# Aceita true/false/1/0; modo true ignora CDP externo; sem fallback visível
HEADLESS=true

# Testing
# Somente 1 habilita testes opcionais de Chrome com feeds locais
BROWSER_TESTS=0

# Opcionais / diagnóstico (deixe comentadas quando não precisar)
# Compatibilidade: fallback de COLLECTION_ENABLED somente se esta estiver ausente; prefira COLLECTION_ENABLED
# POLLING_ENABLED=0
# Seleção manual Bet365; restrinja ESPORTS
# EVENT_ID=id-externo
# Seleção manual Betano; restrinja ESPORTS
# BETANO_EVENT_ID=id-externo
# Endpoint CDP autorizado, somente diagnóstico HEADLESS=false
# CDP_URL=http://127.0.0.1:9222
# Arquivo do Chrome externo, somente diagnóstico visível
# CHROME_DEBUG_PORT_FILE=/caminho/para/DevToolsActivePort
# Banco descartável *_test; suíte SQL TRUNCA tabelas
# TEST_DATABASE_URL=postgresql://odds:local_development_only@127.0.0.1:5433/odds_service_test
