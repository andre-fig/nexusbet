# Runtime suportado para Bet365/Betano: Chrome pessoal existente no macOS.
# Em Railway/Linux: BROWSER_RUNTIME=disabled, BET365_ENABLED=false, BETANO_ENABLED=false.
BROWSER_RUNTIME=local-cdp
BET365_ENABLED=true
BETANO_ENABLED=true
# Opcional: ws://127.0.0.1:<port>/devtools/browser/<id>; nunca commitar endpoint real.
# Ausente: lê CHROME_DEBUG_PORT_FILE ou DevToolsActivePort do Chrome do macOS.
# CDP_ENDPOINT=
CDP_RECONNECT_COOLDOWN_MS=300000

# Somente placeholders locais; não inserir credenciais reais.
# Execute a partir de apps/odds-service. Não sobrescreva um .env existente.

# Application
# Porta; mínimo configurável 0
PORT=3650
# Local: loopback. Docker/Railway: 0.0.0.0 (definido na imagem).
HOST=127.0.0.1
# Lista separada por vírgulas sem espaços
ESPORTS=cs2,lol,valorant
# TTL em segundos, mínimo 1
MAX_AGE_SECONDS=600
# Diferença percentual absoluta para sinalizar outlier no Monitor API
ODDS_OUTLIER_THRESHOLD_PERCENT=10
# Diretório dos estados/journals
DATA_DIR=data

# Database
# Compose: nome do banco
POSTGRES_DB=odds_service
# Compose: usuário local de exemplo
POSTGRES_USER=odds
# Placeholder local; Compose exige senha; nunca usar senha real versionada
POSTGRES_PASSWORD=local_development_only
# Compose: porta local; atualize DATABASE_URL se mudar
POSTGRES_PORT=5433
# URL local de exemplo; obrigatória em modo postgres
DATABASE_URL=postgresql://odds:local_development_only@127.0.0.1:5433/odds_service
# Exemplo postgres; default do código: postgres se URL definida, senão file
PERSISTENCE_MODE=postgres

# Collection
# Exemplo seguro false; default do código true; aceita true/false/1/0
COLLECTION_ENABLED=false
# Espera inicial, mínimo 0
COLLECTION_STARTUP_DELAY_MS=3000
# Tick em memória, mínimo 100; não é polling remoto
COLLECTION_TICK_MS=5000
# Listagem por provider; mínimo 30000
COLLECTION_LIST_INTERVAL_MS=300000
# Detalhe >24h; mínimo 30000
DETAIL_INTERVAL_GT_24H_MS=3600000
# Detalhe 6h–24h inclusivo; mínimo 30000
DETAIL_INTERVAL_6H_24H_MS=1800000
# Detalhe >=1h e <6h; mínimo 30000
DETAIL_INTERVAL_1H_6H_MS=300000
# Detalhe >0 e <1h; mínimo 30000
DETAIL_INTERVAL_LT_1H_MS=60000
# Mínimo 0; variação efetiva limitada a menos de 10000ms
COLLECTION_JITTER_MS=10000
# Timeout listagem; mínimo 1
PROVIDER_LIST_TIMEOUT_MS=60000
# Timeout detalhe; mínimo 1
PROVIDER_DETAIL_TIMEOUT_MS=60000
# Falhas consecutivas para cooldown; mínimo 1
PROVIDER_FAILURE_THRESHOLD=5
# Pausa; mínimo 30000
PROVIDER_COOLDOWN_MS=300000
# Primeira falha; mínimo 30000
COLLECTION_BACKOFF_FIRST_MS=30000
# Segunda falha; mínimo 30000
COLLECTION_BACKOFF_SECOND_MS=60000
# Terceira falha; mínimo 30000
COLLECTION_BACKOFF_THIRD_MS=120000
# Quarta falha e seguintes; mínimo 30000
COLLECTION_BACKOFF_MAX_MS=300000
# Espera antes de abort; commits ainda são drenados; mínimo 0
SHUTDOWN_GRACE_MS=30000
# Scanner local; mínimo 1
INBOX_SCAN_INTERVAL_MS=5000
# Somente 0 desabilita timer; false NÃO desabilita
# Loop CLI legado, mínimo 60; não altera scheduler
CAPTURE_INTERVAL_SECONDS=180

# Ingestão direta; raw é somente diagnóstico temporário
INGESTION_MODE=direct
LEGACY_INBOX_IMPORT_ENABLED=false
RAW_CAPTURE_ENABLED=false
RAW_CAPTURE_RETENTION_HOURS=24
RAW_CAPTURE_DIR=evidence/raw
# Temporary memory diagnostics. Keep disabled outside an investigation window.
MEMORY_DIAGNOSTICS_ENABLED=false
MEMORY_DIAGNOSTICS_INTERVAL_MS=300000
MEMORY_DIAGNOSTICS_STARTUP_DELAY_MS=30000
MEMORY_DIAGNOSTICS_HEAP_SNAPSHOTS=false
MEMORY_DIAGNOSTICS_HEAP_SNAPSHOT_AFTER_MS=1800000

# Bet365
# Mínimo 1; efetivamente limitado a 1
BET365_MAX_CONCURRENCY=1
# Paths antigos são usados somente por db:import-legacy -- --root PATH
# INBOX_DIR=inbox
# DETAIL_INBOX_DIR=detail-inbox

# Betano
# Mínimo 1; efetivamente limitado a 1
BETANO_MAX_CONCURRENCY=1
# BETANO_INBOX_DIR=betano-inbox

# Superbet
# Mínimo 1; efetivamente limitado a 1
SUPERBET_MAX_CONCURRENCY=1
# SUPERBET_INBOX_DIR=superbet-inbox

# Browser/CDP
# Configuração histórica de Chrome próprio (testes locais); local-cdp nunca lança Chrome.
BROWSER_MODE=headed
# Linux/container: display virtual gerenciado pelo entrypoint; no Mac não cria Xvfb
DISPLAY=:99
CHROME_CHANNEL=chrome
BROWSER_PROFILE_DIR=data/chrome-profile
BROWSER_SHARED_INSTANCE=true
BROWSER_SHARED_CONTEXT=true
PROVIDER_MAIN_TAB=true
# Capacidade; providers atuais reutilizam main tab e não abrem detail tab.
PROVIDER_DETAIL_TAB_MAX=1
BROWSER_PERSISTENT=true
BROWSER_LOCALE=pt-BR
BROWSER_TIMEZONE=America/Sao_Paulo
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_EVIDENCE_DIR=evidence/browser
# Compatibilidade quando BROWSER_MODE está ausente; aceita true/false/1/0
HEADLESS=false

# Testing
# Somente 1 habilita testes opcionais de Chrome com feeds locais
BROWSER_TESTS=0

# Opcionais / diagnóstico (deixe comentadas quando não precisar)
# Compatibilidade: fallback de COLLECTION_ENABLED somente se esta estiver ausente; prefira COLLECTION_ENABLED
# POLLING_ENABLED=0
# Seleção manual Bet365; restrinja ESPORTS
# EVENT_ID=id-externo
# Seleção manual Betano; restrinja ESPORTS
# BETANO_EVENT_ID=id-externo
# Alias legado de CDP_ENDPOINT (WebSocket local, nunca URL HTTP)
# CDP_URL=ws://127.0.0.1:<porta>/devtools/browser/<id>
# Caminho alternativo do DevToolsActivePort do Chrome existente
# CHROME_DEBUG_PORT_FILE=/caminho/para/DevToolsActivePort
# Banco descartável *_test; suíte SQL TRUNCA tabelas
# TEST_DATABASE_URL=postgresql://odds:local_development_only@127.0.0.1:5433/odds_service_test


# Railway: configure como service variables, uma réplica e volume /service/data.
# Prazo deve exceder SHUTDOWN_GRACE_MS mais drenagem/fechamento.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=90
# RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0

# Blaze — HTTP público, sem Chrome/login/cookies
BLAZE_ENABLED=true
BLAZE_MAX_CONCURRENCY=1
# BLAZE_INBOX_DIR=blaze-inbox # legado/import apenas

# EstrelaBet — HTTP público Altenar, sem Chrome/login/cookies
ESTRELABET_ENABLED=true
ESTRELABET_MAX_CONCURRENCY=1
# ESTRELABET_INBOX_DIR=estrelabet-inbox # legado/import apenas

# Internal monitor — exact origin; comma-separated origins accepted, never wildcard
ODDS_MONITOR_ORIGIN=http://localhost:3000
# Optional localhost E2E; an isolated COPY with a name ending _validation
# MONITOR_E2E_DATABASE_URL=postgresql://odds:local_development_only@127.0.0.1:5433/odds_monitor_validation
# MONITOR_E2E_FRONTEND_URL=http://127.0.0.1:3300
