ODDS_RUNTIME=collector-agent
COLLECTION_ENABLED=true
COLLECT_BET365=true
COLLECT_BETANO=true
COLLECT_SUPERBET=true
COLLECT_BLAZE=true
COLLECT_ESTRELABET=true
BROWSER_RUNTIME=local-cdp
ODDS_SERVER_URL=https://REPLACE_SERVER_DOMAIN
ODDS_INGESTION_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
AGENT_ID=dedicated-mac
# Set absolute paths outside releases. Use quoted paths when they contain spaces.
ODDS_OUTBOX_DIR=/Users/REPLACE_USER/Library/ApplicationSupport/NexusBet/outbox
ODDS_OUTBOX_MAX_BYTES=67108864
ODDS_OUTBOX_RETENTION_HOURS=24
ODDS_HEARTBEAT_INTERVAL_MS=30000
ODDS_INGESTION_TIMEOUT_MS=30000
RAW_CAPTURE_ENABLED=false
